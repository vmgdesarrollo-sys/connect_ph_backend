# ⚠️  IMPORTANTE - NO COMMIT THIS FILE
# Este archivo es solo de referencia. Los valores reales van en GitHub Secrets.

# ============================================
# GCP AUTHENTICATION
# ============================================
GCP_SA_KEY="""
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "...",
  "client_email": "...",
  ...
}
"""
# Cómo obtener: gcloud iam service-accounts keys create key.json --iam-account=...

GCP_PROJECT_ID="connect-ph-123456"
VPC_ID="projects/connect-ph-123456/global/networks/livekit-vpc"

# ============================================
# DATABASE CREDENTIALS
# ============================================
DB_PASSWORD=" Generar con: openssl rand -base64 32 "
# Esta password debe ser la misma en terraform.tfvars

# ============================================
# LIVEKIT CREDENTIALS
# ============================================
LIVEKIT_API_KEY="sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LIVEKIT_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Cómo obtener: livekit-server --create-api-key (en servidor LiveKit)

# ============================================
# APPLICATION SECRETS
# ============================================
JWT_SECRET=" Generar con: openssl rand -base64 64 "
# Mínimo 64 chars para seguridad

# ============================================
# CORS & FRONTEND
# ============================================
CORS_ORIGINS="https://app.connectph.com,https://admin.connectph.com"
# En desarrollo puedes usar "*", pero producción especifica dominios exactos

# ============================================
# OPTIONAL: SLACK NOTIFICATIONS
# ============================================
SLACK_WEBHOOK="https://hooks.slack.com/services/..."
# Opcional: para recibir notificaciones de deploy en Slack
