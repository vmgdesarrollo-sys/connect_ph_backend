<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="x-apple-disable-message-reformatting" />
    <title>Restablece tu contraseña</title>
  </head>

  <body style="margin:0;padding:0;background-color:#ffffff;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
      Restablece tu contraseña en {{#if appName}}{{appName}}{{else}}Conectando PH{{/if}}.
    </div>

    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#ffffff;">
      <tr>
        <td align="center" style="background-color:#000000;padding:28px 16px 56px 16px;">
          <img
            src="http://190.8.178.105:2082/cpsess0855152648/frontend/jupiter/filemanager/showfile.html?file=00_logo_conectandoph_normal.svg&fileop=&dir=%2Fhome%2Forganiza%2Fpublic_html&dirop=&charset=&file_charset=&baseurl=&basedir="
            width="200"
            height="200"
            alt="{{#if appName}}{{appName}}{{else}}Conectando PH{{/if}}"
            style="display:block;border:0;outline:none;text-decoration:none;height:auto;max-width:200px;"
          />
          <div style="height:14px;line-height:14px;">&nbsp;</div>
          <div style="font-family:Arial, Helvetica, sans-serif;font-size:12px;line-height:16px;color:#ffffff;text-align:center;max-width:420px;">
            Tu copropiedad, mejor gestionada, mejor informada y mejor conectada
          </div>
        </td>
      </tr>

      <tr>
        <td align="center" style="padding:0 16px 32px 16px;">
          <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;border-radius:22px;margin-top:-28px;border:1px solid #f0f0f0;box-shadow:0 10px 24px rgba(0,0,0,0.10);">
            <tr>
              <td style="padding:0;font-family:Arial, Helvetica, sans-serif;">
                <div style="padding:16px 22px 0 22px;">
                  <div style="height:4px;background-color:#AB8B48;border-radius:999px;"></div>
                </div>
                <div style="padding:18px 22px 8px 22px;">
                  <p style="margin:0 0 10px 0;font-size:18px;line-height:26px;color:#AB8B48;font-weight:800;text-align:center;">
                    {{#if fullName}}¡Hola {{fullName}}!{{else}}{{#if firstName}}¡Hola {{firstName}} {{lastName}}!{{else}}¡Hola!{{/if}}{{/if}}
                  </p>
                  <p style="margin:0;font-size:14px;line-height:22px;color:#111111;text-align:center;">
                    Recibimos una solicitud para restablecer tu contraseña en {{#if appName}}{{appName}}{{else}}Conectando PH{{/if}}. Para continuar, haz clic en el botón:
                  </p>
                </div>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding:14px 22px 18px 22px;">
                <a
                  href="{{link}}"
                  style="display:inline-block;background-color:#AB8B48;color:#ffffff;text-decoration:none;padding:12px 26px;border-radius:25px;font-family:Arial, Helvetica, sans-serif;font-size:15px;font-weight:700;"
                >
                  Restablecer contraseña
                </a>
              </td>
            </tr>

            <tr>
              <td style="padding:0 22px 12px 22px;font-family:Arial, Helvetica, sans-serif;">
                <p style="margin:0;font-size:12px;line-height:18px;color:#666666;text-align:center;">
                  Este enlace expirará en 10 minutos por seguridad.
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:6px 22px 26px 22px;font-family:Arial, Helvetica, sans-serif;">
                <p style="margin:0;font-size:12px;line-height:18px;color:#666666;text-align:center;">
                  Si no solicitaste este cambio, puedes ignorar este correo.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>